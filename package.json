{
  "name": "paypilot",
  "displayName": "PayPilot",
  "description": "AI coding assistant with a chat side panel and apply changes",
  "version": "0.0.1",
  "publisher": "paypilot",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "paypilot.openChat",
        "title": "PayPilot: Open Chat"
      },
      {
        "command": "paypilot.setApiKey",
        "title": "PayPilot: Set DeepSeek API Key"
      },
      {
        "command": "paypilot.openDiff",
        "title": "PayPilot: View Diff"
      },
      {
        "command": "paypilot.acceptChanges",
        "title": "PayPilot: Accept Changes"
      },
      {
        "command": "paypilot.rejectChanges",
        "title": "PayPilot: Reject Changes"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PayPilot",
      "properties": {
        "paypilot.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek chat model to use"
        },
        "paypilot.apiBase": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "Base URL for DeepSeek API"
        },
        "paypilot.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional fallback if Secret Storage is not set. Prefer running **PayPilot: Set DeepSeek API Key**."
        },
        "paypilot.maxContextChars": {
          "type": "number",
          "default": 12000,
          "description": "Maximum characters of editor content to include as context"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paypilotSidebar",
          "title": "PayPilot",
          "icon": "$(credit-card)"
        }
      ]
    },
    "views": {
      "paypilotSidebar": [
        {
          "id": "paypilotChatView",
          "name": "Chat",
          "type": "webview",
          "icon": "$(credit-card)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -watch -p ./",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/vscode": "^1.88.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
