{
  "name": "paypilot",
  "displayName": "PayPilot",
  "description": "AI coding assistant with a chat side panel and apply changes",
  "version": "0.0.1",
  "publisher": "paypilot",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "enabledApiProposals": [
    "chatProvider"
  ],
  "contributes": {
    "commands": [
      {
        "command": "paypilot.openChat",
        "title": "PayPilot: Open Chat"
      },
      {
        "command": "paypilot.setApiKey",
        "title": "PayPilot: Set DeepSeek API Key"
      },
      {
        "command": "paypilot.removeApiKey",
        "title": "PayPilot: Remove API Key"
      },
      {
        "command": "paypilot.checkApiKeys",
        "title": "PayPilot: Check API Keys"
      },
      {
        "command": "paypilot.openDiff",
        "title": "PayPilot: View Diff"
      },
      {
        "command": "paypilot.acceptChanges",
        "title": "PayPilot: Accept Changes"
      },
      {
        "command": "paypilot.rejectChanges",
        "title": "PayPilot: Reject Changes"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PayPilot",
      "properties": {
        "paypilot.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "DeepSeek chat model to use"
        },
        "paypilot.apiBase": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "Base URL for DeepSeek API"
        },
        "paypilot.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional fallback if Secret Storage is not set. Prefer running **PayPilot: Set DeepSeek API Key**."
        },
        "paypilot.maxContextChars": {
          "type": "number",
          "default": 12000,
          "description": "Maximum characters of editor content to include as context"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paypilotSidebar",
          "title": "PayPilot",
          "icon": "$(credit-card)"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "paypilot",
        "displayName": "PayPilot Language Models",
        "managementCommand": "paypilot.setApiKey"
      }
    ],
    "views": {
      "paypilotSidebar": [
        {
          "id": "paypilotChatView",
          "name": "Chat",
          "type": "webview",
          "icon": "$(credit-card)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -watch -p ./",
    "compile": "tsc -p ./",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check-updates": "npm outdated",
    "audit-security": "npm audit",
    "update-patch": "npm update",
    "test-build": "npm run build && npm run lint"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.10.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0"
  }
}
